{
  "engines": [
    "copilot"
  ],
  "shape": ".SP.",
  "tier": "core",
  "token_cost": 72000,
  "requires_edition": ">=3.0.0",
  "requires_plugins": [],
  "requires_runtime": {
    "node": ">=22",
    "notes": "Skills and prompts need no runtime. The six document converters (docx-to-md, html-to-md, md-to-eml, md-to-html, md-to-txt, md-to-word) shell out through scripts/shared/tool-runner.cjs and additionally require pandoc on PATH; md-to-html and md-to-word require mermaid-cli on PATH only when the source contains Mermaid blocks. jszip is an optional faster path for md-to-word. Converter scripts resolve the shared runtime by relative depth (../../../scripts/shared), which is why scripts/shared/ sits at the payload root."
  },
  "upstream": {
    "notes": "Source-of-truth is the upstream repo. Mall vendors a specific tag; when upstream tags a new release, Mall automation flags the mismatch. Core is the plugin-native successor to Alex_ACT_Edition v4.2.0.",
    "repo": "https://github.com/fabioc-aloha/Alex_ACT_Core",
    "license": "MIT",
    "ref": "v0.4.0"
  },
  "instruction_scope": {
    "shipped": false,
    "reason": "Core authors 18 ACT instructions (16 always-on + 2 pattern-applied), but plugin.json has no instructions component field, so a plugin install cannot deliver them. This is a platform boundary shared by Copilot CLI, Claude Code, and Open Plugin Spec v1.0 rather than a packaging omission. Core closes the gap at install time: install-constellation Step 6 copies the sixteen always-on ones to ~/.copilot/instructions/ under an alex-act- prefix, consent-gated and receipt-backed. Those sixteen ship as skill resources at skills/install-constellation/bootstrap/ so the copy works on Mall installs. v0.4.0 (2026-08-01) adds greeting-checkin (session-start orientation instruction that offers setup / drift refresh / update reminders on greeting patterns) to the bootstrap payload, and adds /uninstall-constellation (detect-generate-guide flow that writes a machine-tailored PowerShell script for the Windows os error 5 workaround). Verified 2026-07-30 on Copilot CLI 1.0.77 and VS Code Chat 1.131."
  },
