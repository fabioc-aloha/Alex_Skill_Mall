{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fabioc-aloha/Alex_ACT_AI_Operations/model-task-plan.schema.json",
  "title": "Alex ACT Model Task Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "planId",
    "createdAt",
    "task",
    "constraints",
    "candidates",
    "steps",
    "dataBoundary",
    "cost",
    "consent",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "planId": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "goal",
        "modalities",
        "deliverables"
      ],
      "properties": {
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "image",
              "audio",
              "video",
              "multimodal",
              "model",
              "dataset"
            ]
          }
        },
        "deliverables": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "quality",
        "latency",
        "privacy",
        "region",
        "license",
        "budget"
      ],
      "properties": {
        "quality": {
          "type": [
            "string",
            "null"
          ]
        },
        "latency": {
          "type": [
            "string",
            "null"
          ]
        },
        "privacy": {
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "license": {
          "type": [
            "string",
            "null"
          ]
        },
        "budget": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/executionStep"
      }
    },
    "dataBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "sentExternally",
        "providerInputs",
        "retention"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "sentExternally": {
          "type": "boolean"
        },
        "providerInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "retention": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currency",
        "estimateStatus",
        "estimated",
        "maximumApproved"
      ],
      "properties": {
        "currency": {
          "type": "string",
          "minLength": 3,
          "maxLength": 3
        },
        "estimateStatus": {
          "enum": [
            "known",
            "partial",
            "unknown"
          ]
        },
        "estimated": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maximumApproved": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "basis": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "status",
        "approvedPlanHash"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "not-requested",
            "pending",
            "approved",
            "declined",
            "expired"
          ]
        },
        "approvedPlanHash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider",
          "source",
          "observedAt"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "model",
        "operation",
        "feasible",
        "evidence",
        "tradeoffs"
      ],
      "properties": {
        "provider": {
          "enum": [
            "foundry",
            "huggingface",
            "elevenlabs"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "feasible": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "executionStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "provider",
        "model",
        "operation",
        "status",
        "inputs",
        "fallbacks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": [
            "foundry",
            "huggingface",
            "elevenlabs"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "approved",
            "running",
            "succeeded",
            "failed",
            "canceled",
            "blocked"
          ]
        },
        "inputs": {
          "type": "object"
        },
        "fallbacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "providerJobId": {
          "type": [
            "string",
            "null"
          ]
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
